# Only what has to exist before the owner can sign in, or that is about the
# network rather than the app. Buckets, upload limits, share-link defaults and
# OIDC sign-in are all set in the app, under Settings.

# Required.

# PostgreSQL connection string. `npm run db:up` starts a local one matching this.
DATABASE_URL=postgres://s3am:s3am@127.0.0.1:5437/s3am

# Secret better-auth signs sessions and hashes sign-in tokens with. The server
# refuses to start in production while this is unset, shorter than 32 characters
# or still the default.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Optional.

# Public URL the app is served at. Magic-link URLs and the OIDC redirect URI
# are built from it.
# Unset, each request uses the address the browser came in on (behind a proxy,
# set TRUST_PROXY so the forwarded host and scheme are believed).
# APP_URL=http://localhost:3005

# Port the server listens on. Default: 3005
# PORT=3005

# Which proxy hops may set X-Forwarded-For: "false" with nothing in front, a hop
# count ("1") or a subnet list behind a reverse proxy. The sign-in throttle
# counts by client address, so behind a proxy this has to be set or every
# visitor shares the proxy's address and its budget.
# TRUST_PROXY=false

# "true" when nothing hostile can reach this port: entering an address signs you
# straight in, with no link to go and fetch. A LAN you control, and nowhere else,
# because it makes the address the entire credential. Only the owner's address
# (or the first one, on a new instance) signs in either way.
# SECURE_LOCAL_NET=false

# How long boot waits for Postgres to answer before giving up, in milliseconds.
# DB_CONNECT_TIMEOUT_MS=60000

# Return the magic link in the API response, so the login page can offer it.
# Always on outside production; this turns it on in production too. Links are
# otherwise only printed to the server log. Private networks only.
# EXPOSE_MAGIC_LINK=false

# Where `npm run dev:app` proxies /graphql and the OIDC routes. Default: http://localhost:3005
# S3AM_SERVER_URL=http://localhost:3005

# Address `npm run db:up` publishes Postgres on. Defaults to 127.0.0.1, which is
# the loopback of whichever machine runs the Docker daemon — so if
# `docker context ls` shows a remote endpoint, set this to 0.0.0.0 and point
# DATABASE_URL at that host. Trusted networks only.
# DEV_BIND=127.0.0.1
